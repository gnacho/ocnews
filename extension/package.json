{
  "name": "web-app-news",
  "version": "0.2.2",
  "description": "News (RSS/Atom) reader extension for OpenCloud, backed by the ocnews API v1.3 service",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:w": "vite build --watch --mode development",
    "check:types": "vue-tsc --noEmit",
    "lint": "eslint 'src/**/*.{js,ts,vue}' --max-warnings=1 --color",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@opencloud-eu/eslint-config": "^8.2.2",
    "@opencloud-eu/extension-sdk": "^7.4.0",
    "@opencloud-eu/tsconfig": "^7.4.0",
    "@opencloud-eu/web-client": "^7.4.0",
    "@opencloud-eu/web-pkg": "^7.4.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "happy-dom": "^21.0.4",
    "lucide-vue-next": "^1.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12",
    "vue3-gettext": "^4.0.0-beta.1"
  },
  "overrides": {
    "axios": "^1.20.0",
    "adm-zip": "^0.6.1",
    "ws": "^8.21.3"
  }
}

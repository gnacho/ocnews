    "lucide-vue-next": "^1.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.2",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.12",
    "vue3-gettext": "^4.0.0-beta.1"
  },
  "overrides": {
    "axios": "^1.20.0",
    "adm-zip": "^0.6.1",
    "ws": "^8.21.3"

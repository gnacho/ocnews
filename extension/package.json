{
  "name": "web-app-news",
  "version": "0.1.0",
  "description": "News (RSS/Atom) reader extension for OpenCloud, backed by the ocnews API v1.3 service",
  "license": "AGPL-3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "build:w": "vite build --watch --mode development",
